# Copy to .env for local dev (git-ignored). Generate values:
#   APP_KEY:            echo "base64:$(openssl rand -base64 32)"
#   REVERB_APP_SECRET:  openssl rand -hex 24
APP_KEY=
REVERB_APP_SECRET=

# Email (optional). Left unset, the app degrades gracefully: invites show a
# shareable code and "Forgot password?" explains mail isn't set up. Real SMTP
# credentials go in .env only — never commit them.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=app-password
# MAIL_FROM_ADDRESS=you@example.com
# MAIL_SCHEME=smtps   # only for implicit-TLS servers (usually port 465)
